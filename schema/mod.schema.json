{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SBAModLoader mod entry",
  "description": "One file per mod in mods/<id>.json. The hash is the source of truth: a download is only installed if it matches.",
  "type": "object",
  "required": ["id", "name", "author", "kind", "summary", "description", "categories", "version",
               "gameVersions", "size", "sha256", "updated", "source", "openSource", "license", "audited"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$", "description": "Stable identifier; must equal the file name." },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "author": { "type": "string", "minLength": 1, "maxLength": 60 },
    "kind": { "enum": ["fusion", "native", "sbapack"], "description": "fusion: BepInEx plugin (.dll or .zip). native: .so. sbapack: .sbapack." },
    "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(texture_pack/(fun|extra_content|replacement)|mod/(quality_of_life|expansion|changes|cheats|port))$" },
      "description": "category/subcategory pairs; a mod can have several. Must match categories.json."
    },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}([-+][0-9A-Za-z.-]+)?$" },
    "gameVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "size": { "type": "integer", "minimum": 1, "description": "Size of the downloaded file in bytes." },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the downloaded file." },
    "updated": { "type": "string", "format": "date" },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "repo", "tag", "asset"],
          "properties": {
            "kind": { "const": "github" },
            "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "tag": { "type": "string", "minLength": 1 },
            "asset": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "external" },
            "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
          }
        }
      ]
    },
    "openSource": { "type": "boolean", "description": "true: loaded from a GitHub release. false: closed source or all rights reserved, loaded from an external URL." },
    "license": { "type": "string", "minLength": 1, "description": "An SPDX identifier for open source mods; \"All rights reserved\" (or the creator's terms) otherwise." },
    "audited": {
      "type": "object", "additionalProperties": false, "required": ["version", "date", "by"],
      "properties": {
        "version": { "type": "string", "description": "The exact version that was reviewed; must equal version." },
        "date": { "type": "string", "format": "date" },
        "by": { "type": "string", "minLength": 1 }
      }
    },
    "changelog": { "type": "string" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }, "description": "Ids of other mods in this repository." }
  }
}
