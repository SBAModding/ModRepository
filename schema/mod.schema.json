{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SBAModLoader mod entry",
  "description": "One file per mod in mods/<id>.json. The hash is the source of truth: a download is only installed if it matches.",
  "type": "object",
  "required": ["id", "name", "author", "kind", "summary", "description", "categories", "version",
               "gameVersions", "size", "sha256", "updated", "source", "openSource", "license", "audited"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$", "description": "Stable identifier; must equal the file name." },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "author": { "type": "string", "minLength": 1, "maxLength": 60 },
    "kind": { "enum": ["fusion", "native", "sbapack"], "description": "fusion: BepInEx plugin (.dll or .zip). native: .so. sbapack: .sbapack." },
    "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(texture_pack/(fun|extra_content|replacement)|mod/(quality_of_life|expansion|changes|cheats|port))$" },
      "description": "category/subcategory pairs; a mod can have several. Must match categories.json."
    },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}([-+][0-9A-Za-z.-]+)?$" },
    "gameVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "size": { "type": "integer", "minimum": 1, "description": "Size of the downloaded file in bytes." },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the downloaded file." },
    "updated": { "type": "string", "format": "date" },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "repo", "tag", "asset"],
          "properties": {
            "kind": { "const": "github" },
            "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "tag": { "type": "string", "minLength": 1 },
            "asset": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "external" },
            "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
          }
        }
      ]
    },
    "openSource": { "type": "boolean", "description": "true: loaded from a GitHub release. false: closed source or all rights reserved, loaded from an external URL." },
    "license": { "type": "string", "minLength": 1, "description": "An SPDX identifier for open source mods; \"All rights reserved\" (or the creator's terms) otherwise." },
    "audited": {
      "type": "object", "additionalProperties": false, "required": ["version", "date", "by"],
      "properties": {
        "version": { "type": "string", "description": "The exact version that was reviewed; must equal version." },
        "date": { "type": "string", "format": "date" },
        "by": { "type": "string", "minLength": 1 }
      }
    },
    "changelog": { "type": "string" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "mirrors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[^\\s]+$" }, "description": "Optional extra https copies of the same file. The loader tries the primary source first, then these, and accepts any copy that matches sha256 and size." },
    "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }, "description": "Ids of other mods in this repository. The ids-only form that loaders before 0.0.3 read; generated into index.json from dependencies." },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "min": { "$ref": "#/properties/version", "description": "Oldest version of that mod this release works with (inclusive)." },
          "max": { "$ref": "#/properties/version", "description": "Newest version of that mod this release works with (inclusive)." }
        }
      },
      "description": "Mods this release needs, with the versions of them it works with. The loader installs them too."
    },
    "previousVersions": {
      "type": "array",
      "description": "Older releases, newest first. The top level of the file is the newest release.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "gameVersions", "size", "sha256", "updated", "source", "audited"],
        "properties": {
          "version": { "$ref": "#/properties/version" },
          "gameVersions": { "$ref": "#/properties/gameVersions" },
          "size": { "$ref": "#/properties/size" },
          "sha256": { "$ref": "#/properties/sha256" },
          "updated": { "$ref": "#/properties/updated" },
          "source": { "$ref": "#/properties/source" },
          "audited": { "$ref": "#/properties/audited" },
          "changelog": { "$ref": "#/properties/changelog" },
          "mirrors": { "$ref": "#/properties/mirrors" },
          "dependencies": { "$ref": "#/properties/dependencies" }
        }
      }
    },
    "icon": { "type": "string", "pattern": "^images/[a-z0-9][a-z0-9-]{1,63}/[A-Za-z0-9_.-]+\\.(png|jpg|jpeg|webp)$", "description": "Square icon, a file in this repository under images/<id>/ (1 MB at most)." },
    "screenshots": {
      "type": "array", "uniqueItems": true, "maxItems": 8,
      "items": { "type": "string", "pattern": "^images/[a-z0-9][a-z0-9-]{1,63}/[A-Za-z0-9_.-]+\\.(png|jpg|jpeg|webp)$" },
      "description": "Screenshots, files in this repository under images/<id>/ (1 MB each at most)."
    }
  }
}
